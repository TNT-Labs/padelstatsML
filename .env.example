# Copy to .env and adjust. Every value has a working default for a
# Raspberry Pi 5 with an SSD mounted at /mnt/ssd.

# ── Where everything lives ────────────────────────────────────────────────
# Host path bind-mounted to /data inside the containers (SQLite DB, videos,
# keyframes, player thumbnails). Point this at the SSD, not the SD card.
DATA_VOLUME=/mnt/ssd/padelstats
DATA_DIR=/data

# ── API ───────────────────────────────────────────────────────────────────
# Must be reachable from your phone/laptop: it is used to build upload URLs.
API_BASE_URL=http://padelpi.local:8000
# Leave empty for same-origin only (the API serves the web UI itself).
# Set it only when running the Vite dev server on another port, e.g.
# CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

MAX_VIDEO_SIZE_MB=4096

# ── Detector ──────────────────────────────────────────────────────────────
# Exported once with `python scripts/export_yolo_onnx.py` (see
# INSTALL_RASPBERRY.md §6). The Pi never loads PyTorch weights.
DETECTOR_MODEL=/srv/weights/yolov8n.onnx
# Must match the --imgsz used at export time.
DETECTOR_IMGSZ=480
DETECTOR_CONF=0.30
DETECTOR_IOU=0.55
# 0 = auto (physical cores, capped at 4). Leave at 0 on a Pi 5.
INFERENCE_THREADS=0

# ── Re-identification ─────────────────────────────────────────────────────
# OSNet, exported once with `python scripts/export_reid_onnx.py` (see
# INSTALL_RASPBERRY.md §6). Optional: without it, players are told apart by
# kit colour only, which fails when team-mates dress alike. The larger
# osnet_x1_0_msmt17.onnx (`--arch osnet_x1_0`) is more accurate and slower.
REID_MODEL=/srv/weights/osnet_x0_25_msmt17.onnx

# ── Analysis speed vs accuracy ────────────────────────────────────────────
# Player positions are sampled at this rate regardless of the video's fps.
#   3.0 -> ~0.6x real time, distance underestimated ~15%
#   5.0 -> ~1.0x real time (default): a 60 min match takes about 60 min
#   8.0 -> ~1.7x real time, marginal accuracy gain
SAMPLE_HZ=5.0
# Videos longer than this are truncated; the result says so.
MAX_ANALYSIS_MINUTES=120

# ── Tracking / rally tuning (rarely needs changing) ───────────────────────
MAX_PLAYER_SPEED_MS=8.0
TRACK_MAX_AGE_S=1.2
RALLY_SPEED_THRESHOLD_MS=1.1
RALLY_MIN_DURATION_S=3.0
RALLY_MERGE_GAP_S=1.5

# ── Artefatti di analisi ──────────────────────────────────────────────────
# Conserva le osservazioni grezze di ogni analisi (~17 MB per ora di video).
# Servono a scripts/overlay.py (verifica visiva) e scripts/retune.py (taratura
# delle soglie in un secondo invece di una rianalisi completa).
# Disattivalo solo se lo spazio disco è critico.
KEEP_ARTIFACTS=true

# ── Worker ────────────────────────────────────────────────────────────────
JOB_MAX_ATTEMPTS=2
