# Copia in .env. Vanno impostate solo le voci della prima sezione: tutte le
# altre hanno già un valore predefinito, adatto a un Raspberry Pi 5 con SSD,
# e qui sono commentate. Togli il # solo per cambiarle.

# ═════════════════════════════════════════════════════════════════════════
# DA IMPOSTARE
# ═════════════════════════════════════════════════════════════════════════

# Cartella dell'host montata come /data nei container (database, video,
# fotogrammi, anteprime). Sull'SSD, non sulla scheda SD.
DATA_VOLUME=/mnt/ssd/padelstats

# Primo amministratore: creato al primo avvio solo se il database non ha
# ancora utenti. Al primo accesso chiede di scegliere una nuova password;
# dopo, PADEL_ADMIN_PASSWORD si può togliere da qui.
# Password: almeno 10 caratteri, lettere e cifre, senza il nome utente.
PADEL_ADMIN_USERNAME=admin
PADEL_ADMIN_PASSWORD=

# Come è raggiungibile l'app. Predefiniti di docker-compose.yml: dietro il
# tunnel Cloudflare, sotto /padel.
#   - Percorso: vuoto per un'installazione servita dalla radice.
#   - COOKIE_SECURE=true solo dietro HTTPS; false su http in rete locale.
#   - TRUST_CLOUDFLARE=true solo se l'API è raggiungibile esclusivamente dal
#     tunnel (nessuna porta pubblicata).
BASE_PATH=/padel
COOKIE_SECURE=true
TRUST_CLOUDFLARE=true
# Rete Docker dello stack dove gira il tunnel:  docker network ls | grep interna
SITE_NETWORK=3dworks_interna

# ═════════════════════════════════════════════════════════════════════════
# FACOLTATIVI — valori predefiniti
# ═════════════════════════════════════════════════════════════════════════

# ── Solo installazione senza Docker ───────────────────────────────────────
# Con Docker li fissa docker-compose.yml e qui sono ignorati.
# DATA_DIR=/mnt/ssd/padelstats
# DETECTOR_MODEL=/percorso/weights/yolov8n.onnx

# ── Accesso ───────────────────────────────────────────────────────────────
# Sessione: scade dopo 12 ore di inattività e comunque dopo 7 giorni.
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
# Blocco dell'account dopo 5 password errate, per 15 minuti.
# MAX_LOGIN_ATTEMPTS=5
# LOCK_MINUTES=15
# Giorni di conservazione del registro accessi (contiene indirizzi IP).
# AUDIT_KEEP_DAYS=365
# Solo per il server di sviluppo Vite su un'altra porta, es.
# CORS_ORIGINS=http://localhost:5173

# ── Caricamento ───────────────────────────────────────────────────────────
# MAX_VIDEO_SIZE_MB=4096
# Il browser invia il video a pezzi di questa dimensione: Cloudflare rifiuta
# richieste oltre 100 MB, e una connessione caduta costa un pezzo, non tutto.
# UPLOAD_CHUNK_MB=32

# ── Rilevatore ────────────────────────────────────────────────────────────
# Il modello è in weights/ (vedi INSTALL_RASPBERRY.md §6); il percorso nel
# container lo fissa docker-compose.yml.
# Deve coincidere con --imgsz usato nell'esportazione.
# DETECTOR_IMGSZ=480
# DETECTOR_CONF=0.30
# Rilevazioni più incerte, fino a questa soglia, usate solo per proseguire
# la traccia di un giocatore appena perso. Uguale a DETECTOR_CONF per
# disattivarle.
# DETECTOR_CONF_WEAK=0.12
# DETECTOR_IOU=0.55
# Secondo passaggio sulla metà lontana (analisi ~50-80% più lenta): auto lo
# attiva quando i giocatori in fondo sarebbero troppo piccoli per il modello.
# DETECTOR_FAR_PASS=auto
# 0 = automatico (core fisici, al massimo 4).
# INFERENCE_THREADS=0

# ── Acceleratore AI HAT+ (Hailo) ──────────────────────────────────────────
# Usato da solo quando la scheda c'è e funziona, altrimenti il processore
# (INSTALL_RASPBERRY.md §6b). cpu = mai; hailo = errore se manca.
# ACCELERATOR=auto
# Core del processore per l'analisi (1-4). Con la scheda il processore lavora
# senza pause: se il Pi supera gli 80 °C (vcgencmd measure_temp) e rallenta
# (vcgencmd get_throttled diverso da 0x0), 3 lo tiene più fresco.
# WORKER_CPUS=4
# Rete compilata per la scheda; vuoto = quella del pacchetto hailo-models
# adatta al chip.
# Postura dei giocatori (17 punti del corpo) sulla scheda, accanto al
# rilevatore: auto se trova una rete *pose*.hef, off mai. Senza scheda no.
# POSE=auto
# HAILO_POSE_MODEL=
# Postura al secondo anche fra un campione e l'altro, salvata in poses.jsonl
# per raccogliere dati (dritti e rovesci non si distinguono ancora da lì).
# Allunga l'analisi: 0 = solo ai campioni.
# POSE_HZ=0
# HAILO_MODEL=
# Le righe seguenti le scrive scripts/hailo_setup.sh: danno al worker la
# scheda e l'HailoRT del Pi. Senza la scheda la riga COMPOSE_FILE va tolta,
# o i container non partono.
# COMPOSE_FILE=docker-compose.yml:docker-compose.hailo.yml
# HAILO_LIB=/usr/lib/libhailort.so.4.20.0
# HAILO_LIB_NAME=libhailort.so.4.20.0
# HAILO_PYTHON=/usr/lib/python3/dist-packages/hailo_platform

# ── Riconoscimento dei giocatori (re-ID) ──────────────────────────────────
# OSNet, esportato con scripts/export_reid_onnx.py. Se il file manca, i
# giocatori si distinguono solo dal colore della divisa. Il più grande
# osnet_x1_0_msmt17.onnx è più preciso e più lento.
# REID_MODEL=/srv/weights/osnet_x0_25_msmt17.onnx

# ── Velocità contro precisione ────────────────────────────────────────────
# Posizioni campionate a questa frequenza, qualunque sia quella del video.
#   3.0 -> ~0.6x il tempo reale, distanze sottostimate ~15%
#   5.0 -> ~1x il tempo reale: un'ora di partita in circa un'ora
#   8.0 -> ~1.7x il tempo reale, guadagno marginale
# SAMPLE_HZ=5.0
# I video più lunghi vengono troncati; il risultato lo dice.
# MAX_ANALYSIS_MINUTES=120

# ── Tracciamento e scambi ─────────────────────────────────────────────────
# MAX_PLAYER_SPEED_MS=8.0
# TRACK_MAX_AGE_S=1.2
# Tetto della soglia degli scambi (m/s): ogni partita sceglie la sua al di
# sotto. RALLY_SPEED_ADAPTIVE=false usa esattamente questo valore.
# RALLY_SPEED_THRESHOLD_MS=1.1
# RALLY_SPEED_ADAPTIVE=true
# RALLY_MIN_DURATION_S=3.0
# Pause più brevi di questa, dentro uno scambio, non lo spezzano in due.
# RALLY_MERGE_GAP_S=3.0

# ── Artefatti e worker ────────────────────────────────────────────────────
# Rilevazioni grezze di ogni analisi (~17 MB per ora di video): servono a
# ricalcolare senza rianalizzare (refresh, verifica, ricalibrazione).
# KEEP_ARTIFACTS=true
# JOB_MAX_ATTEMPTS=2
