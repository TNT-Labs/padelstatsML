# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
# UI compilata, prodotta da `make web` o dal build Docker
backend/web/

# Secrets and local config
.env
.env.local

# Data (videos, SQLite database, keyframes, thumbnails)
data/
*.db
*.db-wal
*.db-shm

# Pesi dei modelli: i file no, la cartella sì.
# `weights/` per intero la escluderebbe dal clone, e docker compose — che la
# monta — la ricreerebbe come root, rendendo impossibile all'utente scriverci
# il modello esportato.
weights/*
!weights/.gitkeep
*.onnx
# A few hundred bytes, built by hand to stand in for the re-ID network in tests.
!backend/tests/fixtures/*.onnx
*.pt
*.pth

# OS
.DS_Store
Thumbs.db
